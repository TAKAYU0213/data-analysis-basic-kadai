    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "A = np.array([[0, 1], [2, 3], [4, 5]])\n",
    "B = np.array([[0, 1, 2, 3], [4, 5 ,6 ,7]])\n",
    "\n",
    "C = np.dot(A, B)\n",
    "\n",
    "print(\"C:\\n\", C)\n",
    "\n",
    "max_value = np.max(C)\n",
    "\n",
    "print(\"Max value in C:\", max_value)"
   ]
